# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexhibit

# Engagement rule. Spec says 60s; use ~10s for a short demo clip.
DWELL_THRESHOLD_S=10
# Gaps shorter than this (stream seconds) count as continuous presence.
# Must be larger than how often the worker posts events.
DWELL_GRACE_S=3

HEATMAP_ROWS=9
HEATMAP_COLS=16

# If set, worker/admin endpoints require header X-API-Key. Leave empty for local use.
API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: real email on engagement (Gmail: use an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
